{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Veredicto de revision de Codex",
  "type": "object",
  "additionalProperties": false,
  "required": ["veredicto", "hallazgos"],
  "properties": {
    "veredicto": { "type": "string", "enum": ["PASS", "FINDINGS"] },
    "hallazgos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prioridad", "archivo", "linea", "resumen", "evidencia", "arreglo", "bloquea"],
        "properties": {
          "prioridad": { "type": "string", "enum": ["P1", "P2", "P3"] },
          "archivo": { "type": "string" },
          "linea": { "type": ["integer", "null"] },
          "resumen": { "type": "string" },
          "evidencia": { "type": "string" },
          "arreglo": { "type": "string" },
          "bloquea": {
            "type": "boolean",
            "description": "true solo si P1, o P2 que afecta datos o el flujo del agente (perder/duplicar un registro, datos de otro cliente, no poder abrir/guardar/cerrar). false para accesibilidad, foco, estados de carga, casos borde de UI y estilo."
          }
        }
      }
    }
  }
}
